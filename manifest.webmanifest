{
  "name": "Instagram — Benzeri Uygulama",
  "short_name": "Instagram",
  "description": "Instagram benzeri, tamamen yerel çalışan mobil sosyal medya uygulaması prototipi.",
  "id": "/instagram-clone/",
  "start_url": "./index.html#/profile",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "tr",
  "dir": "ltr",
  "categories": ["social", "photo", "entertainment"],
  "icons": [
    { "src": "icons/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Profilim", "short_name": "Profil", "url": "./index.html#/profile" },
    { "name": "Yeni gönderi", "short_name": "Oluştur", "url": "./index.html#/create" },
    { "name": "Mesajlar", "short_name": "Mesajlar", "url": "./index.html#/direct" }
  ]
}
